{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./.test-dist",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "types": ["node"],
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "src/shared/**/*.ts",
    "src/renderer/**/*.ts",
    "src/tests/**/*.ts"
  ],
  "exclude": [
    "src/renderer/**/*.tsx"
  ]
}
